{{!-- TRANG PROFILE --}}
<!DOCTYPE html>
<html lang="en">

<body>
  <div class="profile">
    <div class="profile_control flex justify-between px-6 pt-4 pb-2.5">
      <div class="profile-username flex flex-col justify-center">
        <div class="name__username">
          <h1 class="text-black text-xl font-bold leading-8 cursor-pointer">
            {{user.username}}
          </h1>
        </div>
        <div class="name__nickname">
          <span class="text-black font-normal leading-[20px]">{{user.username}}</span>
        </div>
      </div>
      <div class="profile-avatar">
        <img src="{{user.avatar}}" alt="Avatar"
          class="h-auto max-w-20 object-cover rounded-full outline outline-[0.5px] outline-[#CCD0D5] cursor-pointer" />
      </div>
    </div>
    <div class="px-7 pt-3">
      <span>{{user.quote}}</span>
    </div>

    <!-- FOLLOWER BANNER -->
    <div class="follower-banner flex px-6 pt-4 justify-between">
      <div class="number-follower cursor-pointer">
        <span
          class="text-[14px] font-normal text-[#BEC3C9] leading-[20px] hover:border-b-[1.5px] hover:border-[#BEC3C9]"
          onclick="displayFollowsPanel()">{{followers.length}} followers
        </span>
      </div>

      {{!-- INSTA AND GRAPH ICON --}}
      <div class="flex items-center">
        <svg viewBox="0 0 24 24" class="svg-icon" width="24" height="24">
          <rect fill="white" height="20" rx="5" stroke="currentColor" stroke-width="2" width="20" x="2" y="2"></rect>
          <rect fill="black" height="12" rx="1" width="2" x="11" y="6"></rect>
          <rect fill="black" height="9" rx="1" width="2" x="15" y="9"></rect>
          <rect fill="black" height="5" rx="1" width="2" x="7" y="13"></rect>
        </svg>
        <svg viewBox="0 0 24 24" class="insta-icon ml-2.5" width="24" height="24">
          <path fill="black"
            d="M12 2.982c2.937 0 3.285.011 4.445.064a6.087 6.087 0 0 1 2.042.379 3.408 3.408 0 0 1 1.265.823 3.408 3.408 0 0 1 .823 1.265 6.087 6.087 0 0 1 .379 2.042c.053 1.16.064 1.508.064 4.445s-.011 3.285-.064 4.445a6.087 6.087 0 0 1-.379 2.042 3.643 3.643 0 0 1-2.088 2.088 6.087 6.087 0 0 1-2.042.379c-1.16.053-1.508.064-4.445.064s-3.285-.011-4.445-.064a6.087 6.087 0 0 1-2.043-.379 3.408 3.408 0 0 1-1.264-.823 3.408 3.408 0 0 1-.823-1.265 6.087 6.087 0 0 1-.379-2.042c-.053-1.16-.064-1.508-.064-4.445s.011-3.285.064-4.445a6.087 6.087 0 0 1 .379-2.042 3.408 3.408 0 0 1 .823-1.265 3.408 3.408 0 0 1 1.265-.823 6.087 6.087 0 0 1 2.042-.379c1.16-.053 1.508-.064 4.445-.064M12 1c-2.987 0-3.362.013-4.535.066a8.074 8.074 0 0 0-2.67.511 5.392 5.392 0 0 0-1.949 1.27 5.392 5.392 0 0 0-1.269 1.948 8.074 8.074 0 0 0-.51 2.67C1.012 8.638 1 9.013 1 12s.013 3.362.066 4.535a8.074 8.074 0 0 0 .511 2.67 5.392 5.392 0 0 0 1.27 1.949 5.392 5.392 0 0 0 1.948 1.269 8.074 8.074 0 0 0 2.67.51C8.638 22.988 9.013 23 12 23s3.362-.013 4.535-.066a8.074 8.074 0 0 0 2.67-.511 5.625 5.625 0 0 0 3.218-3.218 8.074 8.074 0 0 0 .51-2.67C22.988 15.362 23 14.987 23 12s-.013-3.362-.066-4.535a8.074 8.074 0 0 0-.511-2.67 5.392 5.392 0 0 0-1.27-1.949 5.392 5.392 0 0 0-1.948-1.269 8.074 8.074 0 0 0-2.67-.51C15.362 1.012 14.987 1 12 1Zm0 5.351A5.649 5.649 0 1 0 17.649 12 5.649 5.649 0 0 0 12 6.351Zm0 9.316A3.667 3.667 0 1 1 15.667 12 3.667 3.667 0 0 1 12 15.667Zm5.872-10.859a1.32 1.32 0 1 0 1.32 1.32 1.32 1.32 0 0 0-1.32-1.32Z">
          </path>
        </svg>
      </div>
    </div>
  </div>

  <div class="edit-btn px-7 py-3 relative">
    {{!-- <a href="/editProfile"> --}}
      <div class="edit-profile border border-[#BEC3C9] px-4 py-[2px] text-center rounded-xl cursor-pointer" onclick="toggleModal()">
        <span class="font-normal leading-[2rem]">Edit Profile</span>
      </div>
    {{!-- </a> --}}
    
  </div>

  <div
    class="nav-profile-bar h-[48px] flex items-center justify-around text-[15px] font-normal border-b-[0.8px] border-[#BEC3C9] relative">
    <div class="nav-item threads switch cursor-pointer text-black" onclick="switchTab('threads')">
      <span>Threads</span>
    </div>
    <div class="nav-item replies cursor-pointer text-[#BEC3C9]" onclick="switchTab('replies')">
      <span>Replies</span>
    </div>
    <div class="nav-item repost cursor-pointer text-[#BEC3C9]" onclick="switchTab('repost')">
      <span>Repost</span>
    </div>
    <!-- Thanh border di chuyển -->
    <div class="nav-active-indicator absolute bottom-0 h-[0.8px] bg-black transition-all duration-300">
    </div>
  </div>


  {{#each threads}}
  {{> thread}}
  {{/each}}



<div id="edit-modal" class="hidden fixed inset-0 flex justify-center items-center bg-black/50 z-10">
    <div class="bg-white flex flex-col w-full h-screen md:w-[600px] md:max-h-[60vh] md:rounded-xl overflow-hidden">
        <div class="flex justify-between items-center px-6 pt-4 border-b border-gray-200">
            <button onclick="toggleModal()" class="text-gray-500 hover:text-gray-700">Cancel</button>
            <h1 class="font-bold text-lg">Edit Profile</h1>
            <div class="w-6"></div>
        </div>

        <div class="flex-grow p-6 overflow-y-auto">
            <!-- Profile Picture -->
            <div class="flex flex-col items-center mb-6">
                <label for="image-upload" class="relative cursor-pointer flex items-center justify-center w-24 h-24 rounded-full bg-gray-200 overflow-hidden">
                    <img id="profile-picture-preview" src="{{user.avatar}}" alt="Profile Picture" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 4v16m8-8H4"></path>
                        </svg>
                    </div>
                </label>
                <input id="image-upload" name="avatar" type="file" accept="image/*" class="hidden" onchange="handleImageSelection(event)">
                <p class="text-sm text-gray-500 mt-2">Change Profile Picture</p>
            </div>
            <div class="mb-4">
                <label for="usernameEdit" class="block text-lg font-medium text-gray-700">Username</label>
                <input type="text" id="usernameEdit" name="username" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2 focus:border-blue-500 focus:ring-blue-500 sm:text-sm" value="{{user.username}}">
            </div>
            <div>
                <label for="quoteEdit" class="block text-lg font-medium text-gray-700">Bio</label>
                <textarea id="quoteEdit" name="quote" rows="3" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">{{user.quote}}</textarea>
            </div>
        </div>
        <div class="flex justify-end items-center px-6 py-4 border-t border-gray-200">
            <button onclick="saveProfile()" class="px-4 py-2 text-white bg-gray-500 rounded-full hover:bg-gray-600">Save</button>
        </div>
    </div>
</div>

  <script>
    const switchTab = (tabName) => {
      const tabs = document.querySelectorAll(".nav-item");
      const indicator = document.querySelector(".nav-active-indicator");

      tabs.forEach((tab, index) => {
        if (tab.classList.contains(tabName)) {
          tab.classList.add("switch");
          tab.style.color = "black";

          // Di chuyển thanh border dưới
          indicator.style.left = `${index * 33.33}%`;
        } else {
          tab.classList.remove("switch");
          tab.style.color = "#BEC3C9";
        }
      });
    };
  </script>

<script>
  function toggleModal() {
    const modal = document.getElementById('edit-modal');
    if (modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
    } else {
        modal.classList.add('hidden');
    }
  }

  document.getElementById('edit-modal').addEventListener('click', function(e) {
    if (e.target === this) {
        toggleModal();
    }
  });

  function handleImageSelection(event) {
    const file = event.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function (e) {
          document.getElementById("profile-picture-preview").src = e.target.result;
      };
      reader.readAsDataURL(file);
    }
  }

async function saveProfile() {
    const username = document.getElementById('usernameEdit').value;
    const quote = document.getElementById('quoteEdit').value;
    const imageInput = document.getElementById("image-upload");
    const avatar = imageInput.files ? imageInput.files[0] : null;
    console.log(avatar);
    const formData = new FormData();
    formData.append('username', username);
    formData.append('quote', quote);
    if (avatar) {
        formData.append('avatar', avatar); // Attach the file if it exists
    }

    fetch('/profile/updateProfile', {
        method: 'POST',
        body: formData, // Use FormData as the body
    }).then(response => {
        if (response.ok) {
            toggleModal();
            window.location.href = "/profile";
        } else {
            alert('Failed to update profile.');
        }
    }).catch(error => {
        console.error('Error:', error);
        alert('Failed to update profile.');
    });
}
</script>
</body>

</html>