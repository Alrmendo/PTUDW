{{!-- TRANG PROFILE --}}
<!DOCTYPE html>
<html lang="en">

<body>
  <div class="profile">
    <div class="profile_control flex justify-between px-6 pt-4 pb-2.5">
      <div class="profile-username flex flex-col justify-center">
        <div class="name__username">
          <h1 class="text-black text-xl font-bold leading-8 cursor-pointer">
            {{user.username}}
          </h1>
        </div>
        <div class="name__nickname">
          <span class="text-black font-normal leading-[20px]">{{user.username}}</span>
        </div>
      </div>
      <div class="profile-avatar">
        <img src="{{user.avatar}}" alt="Avatar"
          class="h-auto max-w-20 object-cover rounded-full outline outline-[0.5px] outline-[#CCD0D5] cursor-pointer" />
      </div>
    </div>
    <div class="px-7 pt-3">
      <span>{{user.quote}}</span>
    </div>

    <!-- FOLLOWER BANNER -->
    <div class="follower-banner flex px-6 pt-4 justify-between">
      <div class="number-follower cursor-pointer">
        <span
          class="text-[14px] font-normal text-[#BEC3C9] leading-[20px] hover:border-b-[1.5px] hover:border-[#BEC3C9]"
          onclick="displayFollowsPanel()">{{followers.length}} followers
        </span>
      </div>

      {{!-- INSTA AND GRAPH ICON --}}
      <div class="flex items-center">
        
      </div>
    </div>
  </div>

  <div class="edit-btn px-7 py-3 relative">
    {{!-- <a href="/editProfile"> --}}
      <div class="edit-profile border border-[#BEC3C9] px-4 py-[2px] text-center rounded-xl cursor-pointer"
        onclick="toggleModal()">
        <span class="font-normal leading-[2rem]">Edit Profile</span>
      </div>
      {{!--
    </a> --}}

  </div>
  <hr>
  <div
    class="nav-profile-bar h-[48px] flex items-center justify-around text-[15px] font-normal border-b-[0.8px] border-[#BEC3C9] relative">
    <div class="nav-item threads switch cursor-pointer text-black">
      <span>Threads</span>
    </div>


  </div>


  {{#each threads}}
  {{> thread}}
  {{/each}}


  <div id="edit-modal" class="hidden fixed inset-0 flex justify-center items-center bg-black/50 z-10">
    <div class="bg-white flex flex-col w-full h-screen md:w-[600px] md:max-h-[60vh] md:rounded-xl overflow-hidden">

      <form onsubmit="handleSubmit(event)" id="edit-profile-form" action="profile/updateProfile" method="POST"
        enctype="multipart/form-data" class="flex flex-col h-full">
        <div class="flex justify-between items-center px-6 pt-4 border-b border-gray-200">
          <button type="button" onclick="toggleModal()" class="text-gray-500 hover:text-gray-700">Cancel</button>
          <h1 class="font-bold text-lg">Edit Profile</h1>
          <button type="submit" class="px-4 py-2 text-white bg-gray-500 rounded-full hover:bg-gray-600">Save</button>
        </div>
        <div class="flex-grow p-6 overflow-y-auto">
          <!-- Profile Picture -->
          <div class="flex flex-col items-center mb-6">
            <label for="image-upload"
              class="relative cursor-pointer flex items-center justify-center w-24 h-24 rounded-full bg-gray-200 overflow-hidden">
              <img id="profile-picture-preview" src="{{user.avatar}}" alt="Profile Picture"
                class="w-full h-full object-cover">
              <div
                class="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 4v16m8-8H4"></path>
                </svg>
              </div>
            </label>
            <input id="image-upload" name="avatar" type="file" accept="image/*" class="hidden"
              onchange="handleImageSelection(event)">
            <p class="text-sm text-gray-500 mt-2">Change Profile Picture</p>
          </div>

          <!-- Username -->
          <div class="mb-4">
            <label for="usernameEdit" class="block text-lg font-medium text-gray-700">Username</label>
            <input type="text" id="usernameEdit" name="username"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2 focus:border-blue-500 focus:ring-blue-500 sm:text-sm"
              value="{{user.username}}">
          </div>

          <!-- Bio -->
          <div>
            <label for="quoteEdit" class="block text-lg font-medium text-gray-700">Bio</label>
            <textarea id="quoteEdit" name="quote" rows="3"
              class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm">{{user.quote}}</textarea>
          </div>
        </div>
      </form>
    </div>
  </div>

  <div id="follow-modal" class="hidden fixed inset-0 flex justify-center items-center bg-black/50">
    <div class="bg-white flex flex-col w-full h-screen md:w-[600px] md:max-h-[70vh] md:rounded-xl">
      <!-- Header -->
      <div class="flex justify-between items-center px-6 pt-4">
        <a href="#" onclick="displayFollowsPanel()" class="text-blue-500 hover:underline">Cancel</a>
        <h1 class="font-bold text-lg">Followers & Following</h1>
        <div class="w-6"></div>
      </div>

      <!-- Tab Switch -->
      <div class="flex justify-center mt-4">
        <button id="followers-tab"
          class="px-4 py-2 font-medium text-blue-500 border-b-2 border-blue-500 focus:outline-none"
          onclick="switchTab('followers')">
          Followers
        </button>
        <button id="following-tab"
          class="px-4 py-2 font-medium text-gray-500 border-b-2 border-transparent hover:text-blue-500 hover:border-blue-500 focus:outline-none"
          onclick="switchTab('following')">
          Following
        </button>
      </div>

      <div id="followers-section" class="flex-1 overflow-y-auto p-4 space-y-4">
        <div class="flex flex-col justify-between">
          {{#each followers}}
          <div class="flex items-center space-x-4">
            <img src="{{avatar}}" alt="Avatar" class="w-10 h-10 rounded-full" />
            <div>
              <h2 class="font-medium text-gray-800">{{username}}</h2>
              {{!-- <p class="text-sm text-gray-500">Follower</p> --}}
            </div>
            <button
              class="px-4 py-1 mb-1 text-sm font-medium text-white bg-gray-500 rounded-full hover:bg-gray-600 disabled">
              Follow
            </button>
          </div>

          {{/each}}

        </div>
      </div>

      <div id="following-section" class="flex-1 overflow-y-auto p-4 space-y-4 hidden">
        <div class="flex  flex-col justify-between">
          {{#each followings}}
          <div class="flex items-center space-x-4">
            <img src="{{avatar}}" alt="Avatar" class="w-10 h-10 rounded-full" />
            <div>
              <h2 class="font-medium text-gray-800">{{username}}</h2>
              {{!-- <p class="text-sm text-gray-500">Following</p> --}}
            </div>
            <button onclick="handleUnfollow('{{username}}')"
              class="px-4 py-1 text-sm font-medium text-white bg-gray-300 text-gray-700 rounded-full hover:bg-gray-400">
              Unfollow
            </button>
          </div>


          {{/each}}
        </div>
      </div>
    </div>
  </div>

  <script>
    function switchTab(tab) {
      const followersTab = document.getElementById('followers-tab');
      const followingTab = document.getElementById('following-tab');
      const followersSection = document.getElementById('followers-section');
      const followingSection = document.getElementById('following-section');

      if (tab === 'followers') {
        followersTab.classList.add('text-blue-500', 'border-blue-500');
        followersTab.classList.remove('text-gray-500', 'border-transparent');
        followingTab.classList.add('text-gray-500', 'border-transparent');
        followingTab.classList.remove('text-blue-500', 'border-blue-500');
        followersSection.classList.remove('hidden');
        followingSection.classList.add('hidden');
      } else if (tab === 'following') {
        followingTab.classList.add('text-blue-500', 'border-blue-500');
        followingTab.classList.remove('text-gray-500', 'border-transparent');
        followersTab.classList.add('text-gray-500', 'border-transparent');
        followersTab.classList.remove('text-blue-500', 'border-blue-500');
        followingSection.classList.remove('hidden');
        followersSection.classList.add('hidden');
      }
    }
  </script>


  <script>
    function toggleModal() {
      const modal = document.getElementById('edit-modal');
      if (modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    document.getElementById('edit-modal').addEventListener('click', function (e) {
      if (e.target === this) {
        toggleModal();
      }
    });

    function displayFollowsPanel() {
      const modal = document.getElementById('follow-modal');
      if (modal.classList.contains('hidden')) {
        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    document.getElementById('follow-modal').addEventListener('click', function (e) {
      if (e.target === this) {
        displayFollowsPanel();
      }
    });
    function handleImageSelection(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function (e) {
          document.getElementById("profile-picture-preview").src = e.target.result;
        };
        reader.readAsDataURL(file);
      }
    }
    async function handleSubmit(event) {
      event.preventDefault();
      const username = document.getElementById('usernameEdit').value;
      const usernameRegex = /^[a-zA-Z0-9._-]{1,30}$/;

      if (!usernameRegex.test(username)) {
        alert('Username contains invalid characters. Only letters, numbers, underscores, dots, and hyphens are allowed.');
        return false;
      }

      const quote = document.getElementById('quoteEdit').value;

      const file = document.getElementById('image-upload').files[0];
      const formData = new FormData();
      formData.append('username', username);
      formData.append('quote', quote);
      if (file) formData.append('file', file);

      try {
        const response = await fetch('http://localhost:3000/profile/updateProfile', {
          method: 'POST',
          body: formData,
        });

        if (response.ok) {
          const result = await response.json();
          alert(result.message || 'Profile updated successfully!');
          window.location.href = "/profile";
        } else {
          const error = await response.json();
          alert(error.error || 'Failed to update profile');
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }


    function handleUnfollow(username) {
      if (!confirm("Are you sure you want to unfollow this user?")) return;

      fetch(`profile/unfollow/${username}`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
      })
        .then((response) => {
          if (!response.ok) {
            throw new Error("Failed to unfollow user.");
          }
          return response.json();
        })
        .then((data) => {
          if (data.success) {
            alert("Successfully unfollowed!");
            window.location.href = "/profile"
          } else {
            alert("Unable to unfollow.");
          }
        })
        .catch((error) => {
          console.error("Error:", error);
          alert("An error occurred. Please try again.");
        });
    }

  </script>



</body>

</html>