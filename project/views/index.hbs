<div class="w-screen h-screen overflow-x-hidden flex flex-col items-center justify-center">
    <div
        class="w-full sm:w-1/2 m-4 font-semibold text-lg text-center cursor-pointer flex justify-center items-center gap-2 text-black">
        <span onclick="toggleTextAndRotate(this)">For you</span>
        <span
            class="h-6 w-6 border flex justify-center items-center transition-transform duration-300 ease-in-out rounded-full hover:scale-110 border-[#CCD0D5] bg-white  ">
            <svg viewBox="0 0 13 12" height="12" width="12">
                <path d="m2.5 4.2 4 4 4-4" fill="none" stroke="currentColor" stroke-linecap="round"
                    stroke-linejoin="round" stroke-width="1.5">
                </path>
            </svg>
        </span>
        

        
        <div class="hidden flex-col justify-between sm:flex sm:h-full sm:fixed sm:top-6 sm:right-6 z-10">
            
            <span class="bg-black py-[6px] px-5 border rounded-xl">
                {{#if isLogin}}
                    <a href="/signout" class="text-white no-underline font-normal text-[15px]">Sign out</a>

                    {{!-- <a href="/profile" class="text-white no-underline font-normal text-[15px]">{{user.username}}</a> --}}
                {{else}}
                    <a href="/login" class="text-white no-underline font-normal text-[15px]">Log in</a>
                {{/if}}
            </span>
            
        </div>
        
    </div>

    <div
        class=" w-full sm:w-[45%] flex-1 overflow-y-auto flex flex-col sm:rounded-t-3xl sm:bg-white sm:border sm:border-[#CCD0D5]">
        <div class="h-full overflow-y-scroll hide-scrollbar">
            <div class="h-[50px] sm:hidden"></div>
            <div class="hidden sm:flex p-5 pb-3 gap-3 items-center border-b border-[#CCD0D5] ">
                {{#if isLogin}}
                <img src="{{user.avatar}}" class="w-[36px] h-[36px] rounded-full" />
                <!-- <span class="mr-auto text-[#777777]">What's new?</span> -->
                <span onclick="toggleModal()" class="mr-auto text-[#777777]">What's new?</span>
                <button
                    class="h-9 w-[70px] font-semibold text-black border border-[#CCD0D5] bg-transparent p-0 rounded-lg">Post</button>
                {{else}}
                <a href="/login" class="flex gap-3 items-center justify-between">
                    <img src="images/av1.jpg" class="w-[36px] h-[36px] rounded-full" />
                    <span class="mr-auto text-[#777777]">What's new?</span>
                </a>
                <button class="h-9 w-[70px] font-semibold text-black border border-[#CCD0D5] bg-transparent p-0 rounded-lg disabled">Post</button>

                {{/if}}
            </div>
            {{#each threads}}
            <div class="flex sm:py-4 sm:px-5 gap-3 border-b border-[#CCD0D5] p-2">
                <img id="avatar" src="{{author.avatar}}" class="w-[36px] h-[36px] rounded-full" />
                <div class="flex flex-col w-full">
                    <div class="flex gap-2 text-black cursor-pointer">
                        <span class="hover:underline">{{author.username}}</span>
                        <span class="text-[#777777]" id="uploadTime">{{formatDate date}}</span>
                    </div>
                    <span id="content" class="thread-content">{{content}}</span>
                    <div class="image-container w-full max-w-full overflow-hidden my-2">
                        <img src="{{image}}" class="max-h-[400px] max-w-full h-auto rounded-[5px]" />
                    </div>

                    <div class="flex items-center gap-5">
                        <div id="" class="p-3 -ml-3 flex items-center h-[18px] gap-1" onclick="handleLike()">
                            <svg viewBox="0 0 18 18" width="18" height="18">
                                <path
                                    d="M1.34375 7.53125L1.34375 7.54043C1.34374 8.04211 1.34372 8.76295 1.6611 9.65585C1.9795 10.5516 2.60026 11.5779 3.77681 12.7544C5.59273 14.5704 7.58105 16.0215 8.33387 16.5497C8.73525 16.8313 9.26573 16.8313 9.66705 16.5496C10.4197 16.0213 12.4074 14.5703 14.2232 12.7544C15.3997 11.5779 16.0205 10.5516 16.3389 9.65585C16.6563 8.76296 16.6563 8.04211 16.6562 7.54043V7.53125C16.6562 5.23466 15.0849 3.25 12.6562 3.25C11.5214 3.25 10.6433 3.78244 9.99228 4.45476C9.59009 4.87012 9.26356 5.3491 9 5.81533C8.73645 5.3491 8.40991 4.87012 8.00772 4.45476C7.35672 3.78244 6.47861 3.25 5.34375 3.25C2.9151 3.25 1.34375 5.23466 1.34375 7.53125Z"
                                    stroke-width="1.25">
                                </path>
                            </svg>
                            <span
                                class="flex items-center justify-center text-[12px] font-normal text-[#cccccc] cursor-pointer">{{likes.length}}</span>
                        </div>
                        <div class="p-3 -ml-3 flex items-center h-[18px] gap-1">
                            <svg viewBox="0 0 18 18" width="18" height="18">
                                <path
                                    d="M15.376 13.2177L16.2861 16.7955L12.7106 15.8848C12.6781 15.8848 12.6131 15.8848 12.5806 15.8848C11.3779 16.5678 9.94767 16.8931 8.41995 16.7955C4.94194 16.5353 2.08152 13.7381 1.72397 10.2578C1.2689 5.63919 5.13697 1.76863 9.75264 2.22399C13.2307 2.58177 16.0261 5.41151 16.2861 8.92429C16.4161 10.453 16.0586 11.8841 15.376 13.0876C15.376 13.1526 15.376 13.1852 15.376 13.2177Z"
                                    stroke-linejoin="round" stroke-width="1.25" stroke="#cccccc"
                                    fill="transparent">
                                </path>
                            </svg>
                            <span
                                class="flex items-center justify-center text-[12px] font-normal text-[#cccccc] cursor-pointer">{{comment.length}}</span>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</div>