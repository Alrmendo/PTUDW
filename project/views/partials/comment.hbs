<div class="flex gap-3 border-b border-[#CCD0D5] py-2 sm:py-4">
    <img id="avatar" src="{{commentId.avatar}}" class="w-9 h-9 rounded-full" />
    <div class="flex flex-col w-full">
        <div class="flex gap-2 text-black">
            <span>{{commentId.username}}</span>
            <span class="text-[#BEC3C9]">{{formatTime date}}</span>
        </div>
        <span id="content" class="thread-content">{{comment}}</span>
    </div>
</div>