<div class="flex p-2 gap-2 border-b border-[#CCD0D5]">
    <img id="avatar" src="{{avatar}}" class="w-9 h-9 rounded-full"/>
    <div class="flex flex-col gap-2 w-full">
        <div class="flex gap-2 text-black">
            <span>{{username}}</span>
            <span class="text-[#BEC3C9]">{{time}}</span>
        </div>
        <span id="content" class="thread-content">{{content}}</span>
    </div>
</div>