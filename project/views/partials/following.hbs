<li class="information-follow flex flex-row justify-between py-7 pl-1 border-b border-[#CCD0D5]">
  <div class="avatar-follow flex items-center justify-center">
    <div class="w-[60%] rounded-full overflow-hidden aspect-square">
      <img class="w-20 h-20 cursor-pointer object-cover" src="{{avatar}}" alt="Avatar" />
    </div>
  </div>

  <div class="follow-item flex flex-row justify-between flex-1">
    <div class="name-container">
      <span class="text-black text-[15px] font-[600] leading-5">{{username}}</span><br />
      <span class="text-[#BEC3C9] text-[15px] font-[400] leading-5">{{fullname}}</span>
    </div>
    <div
      class="follow-back-btn text-black font-[600] text-[15px] p-[0px_16px] border border-[#CCD0D5] rounded-[10px] leading-[32.4px] h-[32.4px] mr-[10px]">
      {{status}}
    </div>
  </div>
</li>