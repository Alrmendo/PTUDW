<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>signup</title>
    <!-- <link rel="stylesheet" href="css/output.css">
    <link rel="shortcut icon" href="assets/favicon.ico" type="image/x-icon"> -->
    <script src="https://cdn.tailwindcss.com"></script>

</head>

<body>
    <div class="flex flex-col min-h-screen">
        <div class="w-full relative flex-1">
            <img src="images/background1.jpeg" class="hidden md:block w-full fixed inset-0">
            
            <div class="md:hidden absolute top-4 left-4">
                <button onclick="window.location.href='index.html'" class="bg-black text-white p-2 rounded-full focus:outline-none">
                    <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- signup form-->
            <div class="absolute inset-0 flex items-center justify-center px-4 md:px-0 pt-11">
                <div class="max-w-md w-full text-center">

                    <div class="text-center text-xl md:text-2xl font-bold font-sans">
                        <p>Create your account!</p>
                    </div>
                    {{#if message}}
                        <div class="text-red-500 text-xl mt-2 mb-2">
                            {{message}}
                        </div>
                    {{/if}}
                    {{!-- {{#if success}}
                    <div id="popup" class="fixed inset-0 flex items-center justify-center bg-gray-500 bg-opacity-50">
                        <div class="bg-white p-6 rounded-lg shadow-lg max-w-sm w-full">
                            <p class="text-center text-lg mb-4">Sign up successfull. Verify your email and go to login page or resend your verification email.</p>
                            <div class="flex justify-center gap-4">
                                <a href="/login" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Login</a>
                                <a href="/resendEmail?email=email" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Resend email</a>
                                {{!-- <button onclick="redirectToLogin()" class="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">Go to Login</button>
                                <button onclick="resendEmail()" class="bg-green-500 text-white px-4 py-2 rounded hover:bg-green-600">Resend Email</button> --}}
                            </div>
                        </div>
                    </div>
                    {{/if}} --}}
                    <form action="/signup" method="post" class="space-y-2 bg-white py-4 md:py-6 rounded-xl text-base mt-4">
                        <div>
                            <input
                            class="w-full  bg-gray-100 rounded-xl px-3 py-3 md:py-4"
                                type="text" id="username" name="username" placeholder="Enter Username" required
                            >
                        </div>
                        <div>
                          <input
                          class="w-full  bg-gray-100 rounded-xl px-3 py-3 md:py-4"
                              type="email" id="email" name="email" placeholder="Enter your Email" required
                          >
                        </div>
                        <div>
                            <input
                                class="w-full  bg-gray-100 rounded-xl px-3 py-3 md:py-4"
                                type="password" id="password" name="password" placeholder="Enter your Password" required
                            >
                        </div>
                        <div>
                            <button
                                type="submit"
                                class="w-full bg-black text-white font-medium py-3 md:py-4 rounded-xl">
                                Sign up
                            </button>
                        </div>
                    </form>
                
                    <div class="mb-4 md:mb-3 text-center text-sm text-gray-600">
                        <a href="/resetPassword">Forgot your password?</a>
                    </div>
                
                    <div class="flex items-center my-3 ">
                        <hr class="flex-grow border-gray-300">
                        <span class="mx-3 text-gray-600">or</span>
                        <hr class="flex-grow border-gray-300">
                    </div>
                
                    <div class="text-center text-sm font-bold ">
                        <a href="/login" class="border border-gray-300 rounded-xl px-8 md:px-12 py-3 md:py-4 block">Log in</a>
                    </div>
                </div>
            </div>
        </div>
    
        <!-- Footer -->
        <div class="relative py-4 md:pb-6 md:pt-0 text-center text-sm">
            <p class="space-x-2 md:space-x-4">
                © 2024
                <a href="#" class="footer-link hover:underline">Threads Terms</a>
                <a href="#" class="footer-link hover:underline">Privacy Policy</a>
                <a href="#" class="footer-link hover:underline">Cookies Policy</a>
                <a href="#" class="footer-link hover:underline">Report a problem</a>
            </p>
        </div>
    </div>
</body>
<script>

</script>
</html>