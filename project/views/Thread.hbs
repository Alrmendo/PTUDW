  <div class="hidden sm:flex p-5 pb-3 gap-3 items-center border-b border-[#CCD0D5] justify-between">
    {{#if isLogin}}
      <img src="{{user.avatar}}" class="w-[36px] h-[36px] rounded-full" />
      <!-- <span class="mr-auto text-[#777777]">What's new?</span> -->
      <span onclick="toggleModal()" class="mr-auto text-[#777777]">What's new?</span>
      <button
          class="h-9 w-[70px] font-semibold text-black border border-[#CCD0D5] bg-transparent p-0 rounded-lg">Post</button>
      {{else}}
      <a href="/login" class="flex gap-3 items-center justify-between">
          <img src="images/av1.jpg" class="w-[36px] h-[36px] rounded-full" />
          <span class="mr-auto text-[#777777]">What's new?</span>
      </a>
      <button class="h-9 w-[70px] font-semibold text-black border border-[#CCD0D5] bg-transparent p-0 rounded-lg disabled">Post</button>
    {{/if}}
  </div>

  {{#each threads}}
  {{> thread}}
  {{/each}}
</div>

<div id="post-modal" class="hidden fixed inset-0 flex justify-center items-center bg-black/50 z-10">
    <div class="bg-white flex flex-col w-full h-screen md:w-[600px] md:max-h-[50vh] md:rounded-xl">
        <!-- Header -->
        <div class="flex justify-between items-center px-6 pt-4">
            <a href="#" onclick="toggleModal()">Cancel</a>
            <h1 class="font-bold text-lg">New Thread</h1>
            <div class="w-6"></div>
        </div>
        <!-- Main Content -->
        <div class="pt-8 flex flex-grow px-6">
            <div class="pr-3">
                <img src="{{user.username}}" class="w-[36px] h-[36px] rounded-full" />
            </div>
            <div class="flex-grow">
                <p class="font-semibold">rmuhm_</p>
                <textarea
                    class="w-full rounded-xl pr-4 py-3 resize-none overflow-auto border-none focus:outline-none"
                    id="text-post-popup" placeholder="Create a thread..." required rows="4" oninput="adjustHeight(this)"
                ></textarea>
                <div class="flex items-center pt-4">
                    <!-- Image -->
                    <label for="image-upload" class="cursor-pointer flex items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 fill-current text-black" viewBox="0 0 48 48">
