<div>
    <div id="overlay" class="fixed inset-0 bg-white bg-opacity-80 hidden z-90"></div>
    {{#each threads}}
    {{> thread}}
    {{/each}}
    <div class="flex justify-center py-2 sm:py-4 border-b border-[#333333]">
        <span class="font-bold" onclick="showCommentSection()">Leave a comment</span>
    </div>
    {{#each comments}}
    {{> comment}}
    {{/each}}

    {{!-- Model Comment --}}
    <div id="comment-section"
        class="w-full fixed hidden transform -translate-x-1/2 -translate-y-1/2 bg-white rounded-lg sm:w-1/2 sm:h-1/3 sm:border sm:border-[#CCD0D5] top-1/2 left-1/2 z-100">
        <div class="h-[50px] flex relative items-center">
            <span class="cursor-pointer ml-2" onClick="quitCommentSection()">Cancel</span>
            <span class="font-bold absolute left-1/2 transform -translate-x-1/2 text-center">Reply Thread</span>
        </div>
        <hr class="border-[#CCD0D5]">
        <div class="h-20 w-full flex items-center bg-white gap-2 rounded-lg p-2">
            <img src="{{avatar}}" alt="Avatar" class="w-10 h-10 rounded-full" />
            <input id="commentContent" type="text" placeholder="Write a comment..."
                class="flex-1 bg-white border-none text-black outline-none ml-2" />
        </div>
        <div class="flex w-full mt-20 items-center">
            <span class="text-sm text-[#BEC3C9] m-2">Anyone can see</span>
            <button id="postComment" onclick="sendComment()"
                class="h-9 py-[6px] px-4 w-[68px] font-semibold bg-blue-500 text-white rounded hover:bg-blue-600 m-2 ml-auto rounded-lg disabled:opacity-50 disabled:cursor-not-allowed"
                disabled>Post</button>
        </div>
    </div>
</div>
<script>
    document.getElementById('commentContent').addEventListener('input', function () {
        const commentContent = this.value.trim();
        const postButton = document.getElementById('postComment');

        postButton.disabled = commentContent === '';
    });
    document.getElementById('commentContent').addEventListener('input', function () {
        const postButton = document.getElementById('postComment');
        const content = document.getElementById('commentContent').value;

        if (content.trim() === '') {
            postButton.disabled = true;
            postButton.classList.add('opacity-30', 'cursor-not-allowed');
            postButton.classList.remove('opacity-100');
        } else {
            postButton.disabled = false;
            postButton.classList.add('opacity-100');
            postButton.classList.remove('opacity-30', 'cursor-not-allowed');
        }
    });
    function showCommentSection() {
        document.getElementById('overlay').classList.remove('hidden');
        document.getElementById('comment-section').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function quitCommentSection() {
        document.getElementById('overlay').classList.add('hidden');
        document.getElementById('comment-section').classList.add('hidden');
        document.body.style.overflow = 'auto';
    }
    async function sendComment() {
        const content = document.getElementById('commentContent').value;
        let id = window.location.href.split('/').pop();
        const response = await fetch(`http://localhost:3000/comment/${id}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ content: content })
        });
        if (response.ok) {
            window.location.reload();
        }
    }
</script>